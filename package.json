{
  "name": "qyther",
  "version": "1.0.0",
  "description": "Qyther - AI-powered command launcher and research assistant for Windows",
  "main": "out/main/main.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "install-playwright": "npx playwright install chromium",
    "build:win": "npm run build && electron-builder --win",
    "build:win:dir": "npm run build && electron-builder --win dir",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "keywords": [
    "electron",
    "react",
    "launcher",
    "command-palette",
    "ai-assistant",
    "productivity"
  ],
  "author": "Qyther",
  "license": "SEE LICENSE IN LICENSE",
  "build": {
    "appId": "com.qyther.app",
    "productName": "Qyther",
    "copyright": "Copyright (c) 2026 Qyther",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Qyther",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1031.0",
    "@formkit/auto-animate": "^0.9.0",
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.39",
    "@langchain/langgraph": "^1.2.8",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.3",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.2.2",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clipboard-event": "^1.6.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.0",
    "epub2": "^3.0.2",
    "extract-zip": "^2.0.1",
    "fuse.js": "^7.0.0",
    "koffi": "^2.15.6",
    "langchain": "^1.3.1",
    "langsmith": "^0.5.0",
    "libwin32": "^0.11.1",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "unzipper": "^0.12.3",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@types/extract-zip": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-icon-builder": "^2.0.1",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.9",
    "shadcn": "^4.2.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.0.0"
  }
}
