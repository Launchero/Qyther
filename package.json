{
  "name": "qyther",
  "version": "1.0.0",
  "description": "Qyther - AI-powered command launcher and research assistant for Windows",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "install-playwright": "npx playwright install chromium",
    "build:win": "npm run build && electron-builder --win",
    "build:win:dir": "npm run build && electron-builder --win dir",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "keywords": [
    "electron",
    "react",
    "launcher",
    "command-palette",
    "ai-assistant",
    "productivity"
  ],
  "author": "Qyther",
  "license": "SEE LICENSE IN LICENSE",
  "build": {
    "appId": "com.qyther.app",
    "productName": "Qyther",
    "copyright": "Copyright (c) 2026 Qyther",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Qyther",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@formkit/auto-animate": "^0.9.0",
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.5",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.3.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clipboard-event": "^1.6.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "epub2": "^3.0.2",
    "extract-zip": "^2.0.1",
    "fuse.js": "^7.3.0",
    "koffi": "^2.16.2",
    "langchain": "^1.4.0",
    "langsmith": "^0.6.3",
    "libwin32": "^0.11.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pngjs": "^7.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "unzipper": "^0.12.3",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@types/extract-zip": "^2.0.0",
    "@types/node": "^22.19.18",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-icon-builder": "^2.0.1",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "shadcn": "^4.7.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
