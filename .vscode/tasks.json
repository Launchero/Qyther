{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*electron-vite dev.*$",
          "endsPattern": "^.*VITE.*ready in.*$"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}