# Application Settings
# For development only. Buyers use the in-app API key setup flow.
ELECTRON_VITE_DEV_MODE=true

# OpenAI-compatible endpoint (Alibaba Cloud DashScope)
API_KEY=sk-your-api-key-here
BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
MODEL=qwen3.5-plus
FAST_MODEL=

# === WEB SEARCH AND PAGE FETCH ===
# Search needs no key: DuckDuckGo, Startpage and Mojeek are tried in that order.
# The keys below add two more search providers to the end of that chain and one
# remote page reader (r.jina.ai) used when the built-in HTML extractor cannot
# read a page, e.g. one that needs JavaScript to render. All optional.
# TAVILY_API_KEY=      # https://tavily.com/ (1000 searches/month free tier)
# BRAVE_API_KEY=       # https://brave.com/search/api/
# JINA_API_KEY=        # raises rate limits on the remote reader; keyless works

# Optional: LangSmith tracing (for debugging)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key

# === LOGGING CONFIGURATION ===
# Global log level: silent | error | warn | info | debug
# Controls minimum severity across all subsystems.
# Default: info in development, error in production
# LOG_LEVEL=info

# Per-subsystem overrides:
#   true  = force debug level (verbose logging for that subsystem)
#   false = force silent (suppress all output for that subsystem)
#   unset = inherit from LOG_LEVEL
# LOG_APP=true
# LOG_WINDOW=true
# LOG_IPC=true
# LOG_CHAT=true
# LOG_BROWSER=true
# LOG_MCP=true
# LOG_LANGCHAIN=true
# LOG_GRAPH=true
# LOG_SEARCH=true

# Preload script remote logging (POST to localhost debug endpoint)
# Disabled by default — only enable during active development
# LOG_PRELOAD=false
# LOG_PRELOAD_ENDPOINT=http://127.0.0.1:7593/ingest/<your-id>
# LOG_PRELOAD_SESSION_ID=<your-session-id>

# Renderer log level (same hierarchy as LOG_LEVEL)
# VITE_LOG_LEVEL=debug
# VITE_DEBUG_SEARCH=true
