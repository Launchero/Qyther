# Custom LLM Provider Configuration (OpenAI-Compatible API)
# ==========================================================
# For self-hosted LLM inference (vLLM, Ollama, LM Studio, etc.)
# or custom OpenAI-compatible endpoints

# Enable custom LLM provider
# Set to 'true' to use custom provider instead of default
USE_CUSTOM_LLM_PROVIDER=false

# Custom LLM Base URL
# Examples:
# - vLLM: http://localhost:8000/v1
# - Ollama: http://localhost:11434/v1
# - LM Studio: http://localhost:1234/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Together AI: https://api.together.xyz/v1
LLM_BASE_URL=http://localhost:8000/v1

# Custom LLM API Key
# For local providers (vLLM, Ollama, LM Studio): can be empty or dummy value
# For hosted providers: use your actual API key
LLM_API_KEY=

# Custom LLM Model Name
# Examples:
# - vLLM: meta-llama/Llama-2-7b-chat-hf
# - Ollama: llama2, mistral, codellama
# - LM Studio: your-loaded-model-name
# - OpenAI: gpt-4, gpt-3.5-turbo
# - Anthropic (via OpenRouter): anthropic/claude-2
LLM_MODEL=meta-llama/Llama-2-7b-chat-hf

# Optional: LLM Provider Type
# Helps with provider-specific configurations
# Options: 'openai', 'ollama', 'vllm', 'lm-studio', 'custom'
LLM_PROVIDER_TYPE=custom

# Optional: Custom LLM Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=30000

# ==================== OpenCode SDK Configuration ====================
# OpenCode SDK - AI-powered Ask Mode
# Docs: https://opencode.ai/docs/sdk/

# Enable OpenCode SDK (set to 'false' to disable)
OPENCODE_ENABLED=true

# OpenCode Server URL (default: http://localhost:4096)
OPENCODE_BASE_URL=http://localhost:4096

# Default model to use (see opencode.json for available options)
# Options: openai/gpt-4o, openai/gpt-4-turbo, google/gemini-2.0-pro,
#          google/gemini-2.0-flash, anthropic/claude-sonnet-4-5,
#          ollama/llama3, ollama/codellama
# Alibaba Cloud Coding Plan: bailian-coding-plan/qwen3.5-plus, bailian-coding-plan/qwen3-coder-plus
OPENCODE_MODEL=bailian-coding-plan/qwen3.5-plus

# API Keys for LLM providers (at least one required)
# Note: Anthropic blocked OpenCode in Jan 2026 - use OpenAI or Google instead
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Alibaba Cloud Model Studio API Key (for Coding Plan)
# Format: sk-sp-xxx (Singapore region)
# Docs: https://www.alibabacloud.com/help/en/model-studio/opencode-coding-plan
ALIBABA_CLOUD_API_KEY=your_alibaba_cloud_api_key_here

# MCP Server Configuration
# Enable/disable specific MCP servers (true/false)
OPENCODE_MCP_FILESYSTEM_ENABLED=true
OPENCODE_MCP_GITHUB_ENABLED=false
OPENCODE_MCP_CONTEXT7_ENABLED=false
OPENCODE_MCP_PLAYWRIGHT_ENABLED=false

# Session Persistence
# Set to 'true' to persist sessions across app restarts
OPENCODE_SESSION_PERSISTENCE=true

# ==================== Application Settings ====================
# Enable verbose logging for debugging
ELECTRON_VITE_DEV_MODE=true
