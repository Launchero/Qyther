build/
!build/icons/
!build/icon.ico
!build/icon.png

# Vite cache
.vite/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables (IMPORTANT: Keep secrets out of git)
.env
.env.*
!.env.example
!.env.development
!.env.production

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# Electron
*.tgz
compile_commands.json
.depshash
.tern-port
electron-api.json
electron.d.ts
ts-gen/

# npm configuration
.npmrc
**/.npmrc

# Testing
coverage/
.nyc_output/
.jest/

# ESLint cache
.eslintcache

# TypeScript cache
*.tsbuildinfo

# Misc
.cache/
temp/
tmp/

# Cursor (IDE)
.cursor/
.cursor/rules/generated/

# Playwright MCP
.playwright-mcp/

# Git hooks
.husky/

# Ad-hoc test scripts (one-off local testing files)
test-*.js
test-*.mjs
test-*.ts

# Private keys (NEVER commit)
*.pem
*.key
*.cert
private.key
public.key

# Tesseract / OCR trained data
*.traineddata

# Local data dumps / scratch files
posts-digest.md
*-relevant-posts.json
launcher-relevant-posts.json

# Local data files
*.data

# Temporary mockup/scratch files
mockup-*.html

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# Generated lint/test reports
lint-output*.txt

# Python artifacts (if using Python tooling)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
