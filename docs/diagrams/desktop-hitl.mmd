---
title: Desktop agent path with HITL danger gate
---
%%{accTitle: "Desktop path: intent desktop enters the 7-node subgraph (memoryRetrieve, planner, executeSubtask, delegateToBrowser, verifier, recovery, memoryStore). executeSubtask drives a flat ReAct loop; each tool call passes the DANGER_POLICY gate (29 safe, 2 reviewable, 1 dangerous), non-safe actions interrupt for approve or deny, then verify, recovery, and memoryStore. Tools reach Win32/UIA/OCR through the DesktopAdapter."}%%
flowchart TB
  classDef node fill:#0a0a0a,stroke:#38bdf8,stroke-width:2px,color:#fafafa;
  classDef gate fill:#2a0d0d,stroke:#e5484d,color:#fafafa;
  classDef layer fill:#0d1b22,stroke:#5b6470,color:#fafafa;
  classDef term fill:#1b1b1b,stroke:#5b6470,color:#fafafa;

  IN(["intent = desktop"]):::term
  MR["memoryRetrieve<br/>(sql.js trajectories)"]:::node
  PL["planner<br/>desktop-planner.ts"]:::node
  EX["executeSubtask<br/>desktop-subgraph.ts"]:::node
  DB["delegateToBrowser<br/>desktop-subgraph.ts"]:::node
  VF["verifier (912 lines)<br/>UIA-first · screenshot fallback<br/>w.4 pixel.4 ocr.2 · reject<0.3"]:::node
  RC["recovery<br/>retry/replan/abort"]:::node
  MS["memoryStore"]:::node
  ENDN(["END"]):::term

  IN --> MR --> PL --> EX
  PL -- "isBrowserTask" --> DB
  EX -- "verifier" --> VF
  EX -- "delegateToBrowser" --> DB
  DB -- "executeBrowserSubgraph (stdio JSON-RPC)" --> VF
  VF -- "pass" --> MS
  VF -- "fail" --> RC
  RC -- "retry → executeSubtask" --> EX
  RC -- "replan → planner" --> PL
  RC -- "abort → memoryStore" --> MS
  MS --> ENDN

  subgraph REACT["Flat ReAct loop (DesktopAgent.runReactLoop, desktop-agent.ts) driven per subtask"]
    direction TB
    TOOL["32 tools (desktop-tools.ts)"]:::node
    DG{"DANGER_POLICY gate<br/>29 safe · 2 reviewable (drag, execute_command) · 1 dangerous (close_window)<br/>file_operations per-action "}:::gate
    INT{"interrupt() "}:::gate
    HITL["desktop:confirmation-request<br/>→ chat:resumeGraph new Command({resume})"]:::gate
    TOOL --> DG
    DG -- "safe → execute" --> TOOL
    DG -- "!== safe" --> INT --> HITL
    HITL -- "approve → execute" --> TOOL
    HITL -- "deny → ToolMessage+HumanMessage<br/>'Do NOT attempt again'" --> TOOL
  end
  EX -.drives.-> TOOL

  subgraph BACKEND["Native layers"]
    direction TB
    AD["DesktopAdapter (windows-adapter.ts)"]:::layer
    W32["koffi FFI · libwin32<br/>user32.dll / shell32.dll"]:::layer
    UIA["node-winautomation COM UIA<br/>uia-native.ts"]:::layer
    OCR["tesseract.js OCR · Electron desktopCapturer"]:::layer
    AD --> W32
    AD --> UIA
    AD --> OCR
  end
  TOOL -- "FFI/DLL · COM · capture" --> AD
