---
title: Desktop agent path with the pixel verifier
---
%%{accTitle: "Desktop path: intent desktop enters the AskGraph's desktopAgent node, which makes a single call to the Pi desktop agent — one Agent loop over 32 TypeBox tools, no subgraph. Pi owns the loop, streams typed AgentEvents into a bridge, and runs the automatic GroundTruthVerifier pixel check only for a tool whose result sets details.verifies (close_window today). There is no approval gate: every tool runs without asking. Cancelling a turn aborts the run through abortPiDesktopRun, and withAbort settles the node even if the model never answers. Tools reach Win32/UIA/OCR through the DesktopAdapter."}%%
flowchart TB
  classDef node fill:#0a0a0a,stroke:#38bdf8,stroke-width:2px,color:#fafafa;
  classDef gate fill:#2a0d0d,stroke:#e5484d,color:#fafafa;
  classDef layer fill:#0d1b22,stroke:#5b6470,color:#fafafa;
  classDef term fill:#1b1b1b,stroke:#5b6470,color:#fafafa;

  IN(["intent = desktop"]):::term
  DN["desktopAgent node<br/>research-agent.ts"]:::node
  ENDN(["END"]):::term

  IN --> DN --> ENDN

  subgraph AGENT["Pi desktop agent (pi/agent.ts) — one Agent, no graph"]
    direction TB
    PR["Provider: openai-completions<br/>pi/provider.ts · lazy, memoised"]:::node
    SP["System prompt<br/>pi/prompt.ts · tool priority"]:::node
    LOOP["Agent.prompt() loop<br/>pi-agent-core · toolExecution: parallel"]:::node
    BR["AgentEvent → bridge<br/>pi/events.ts · pure, typed union"]:::node
    PR --> LOOP
    SP --> LOOP
    LOOP --> BR
  end
  DN -- "runPiDesktopTask(task, sessionId, bridge)" --> LOOP

  subgraph REACT["Toolbox (pi/toolbox.ts) — 32 TypeBox AgentTools"]
    direction TB
    TOOL["32 tools<br/>tools never throw: isError + details"]:::node
    SHOT{"details.verifies ?<br/>only close_window sets it<br/>no approval gate — every tool runs without asking"}:::gate
    TOOL --> SHOT
    SHOT -- "yes → GroundTruthVerifier" --> TOOL
    SHOT -- "no → result back to the loop" --> TOOL
  end
  BR -- "tool_execution_start / _end" --> TOOL
  LOOP -.drives.-> TOOL

  VF["GroundTruthVerifier<br/>verifier.ts · pixel diff 0.01 / effect 0.02<br/>hard-reject or score &lt;0.5 → agent.steer()"]:::gate
  SHOT -- "verifies" --> VF
  VF -.steer.-> LOOP

  AB["Abort: chat pump finally →<br/>abortPiDesktopRun() → withAbort settles the node"]:::node
  LOOP -- "signal" --> AB

  subgraph BACKEND["Native layers"]
    direction TB
    AD["DesktopAdapter (windows-adapter.ts)"]:::layer
    W32["koffi FFI · libwin32<br/>user32.dll / shell32.dll"]:::layer
    UIA["node-winautomation COM UIA<br/>uia-native.ts"]:::layer
    OCR["tesseract.js OCR · Electron desktopCapturer"]:::layer
    AD --> W32
    AD --> UIA
    AD --> OCR
  end
  TOOL -- "FFI/DLL · COM · capture" --> AD