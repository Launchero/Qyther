  IN(["Ask turn: the model picks a tool<br/>no intent, no classifier, no node"]):::term

  subgraph LIVE["What a shipped desktop turn actually runs"]
    direction TB
    LOOP["One Agent per turn — pi/ask-turn.ts runAskTurn()<br/>toolExecution: sequential · thinkingLevel: off<br/>six families bound by pi/ask-tools.ts"]:::node
    FAM["desktop family — 32 TypeBox AgentTools<br/>pi/toolbox.ts, handed over by getDesktopToolbox()"]:::node
    BR["AgentEvent → AskEventTranslator (pi/ask-events.ts)<br/>step = tool name, label = displayLabelFor()"]:::node
    AB["Abort: chat:cancelTurn → the pump's controller<br/>→ agent.abort(); withAbort (pi/abort.ts) settles the run"]:::gate
    LOOP --> FAM
    LOOP --> BR
    LOOP -.signal.-> AB
  end
  IN --> LOOP

  subgraph REACT["Tool contract (pi/toolbox.ts)"]
    direction TB
    TOOL["32 tools<br/>never throw: isError + details.status<br/>details.verifies is set only on close_window"]:::node
  end
  FAM --> TOOL

  subgraph UNWIRED["PiDesktopAgent (pi/agent.ts) — built, and reached by no production call site"]
    direction TB
    DLOOP["new Agent: toolExecution parallel<br/>own per-run AbortController"]:::unwired
    SHOT{"initial screenshot<br/>skipped for simple window tasks"}:::unwired
    VF["GroundTruthVerifier (desktop/verifier.ts)<br/>pixel diff 0.01 / effect 0.02<br/>hard-reject or score below 0.5 → agent.steer()"]:::unwired
    ENTRY["runPiDesktopTask() · getPiDesktopAgent() · abortPiDesktopRun()<br/>ZERO production callers — the only production import of this<br/>file is getDesktopToolbox() and the quit step closePiDesktopAgent()"]:::unwired
    SHOT --> DLOOP
    DLOOP -- "tool set details.verifies" --> VF
    VF -.steer.-> DLOOP
    ENTRY -.-> DLOOP
  end
  TOOL -. "verifier would hook here — it does not, today" .-> VF

  subgraph BACKEND["Native layers — shared by both loops through one memoised runtime"]
    direction TB
    AD["DesktopAdapter (desktop/windows-adapter.ts)<br/>+ AccessibilityTreeAdapter + GroundTruthVerifier<br/>released by disposeDesktopRuntime() on quit"]:::layer
    W32["koffi FFI · libwin32<br/>user32.dll / shell32.dll"]:::layer
    UIA["node-winautomation COM UIA<br/>desktop/uia-native.ts"]:::layer
    OCR["tesseract.js OCR · Electron desktopCapturer"]:::layer
    AD --> W32
    AD --> UIA
    AD --> OCR
  end
  TOOL -- "FFI/DLL · COM · capture" --> AD
